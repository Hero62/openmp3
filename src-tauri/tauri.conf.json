{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openmp3",
  "identifier": "com.hero62.openmp3",
  "build": {
    "frontendDist": "../ui/host"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "openmp3",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 120,
        "visible": false,
        "backgroundColor": "#121212",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --js-flags=--lite-mode --disable-background-networking --disable-component-update"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "http://theme.localhost theme: http://themeb.localhost themeb:",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
