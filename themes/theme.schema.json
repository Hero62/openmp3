{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmp3://theme.schema.json",
  "title": "openmp3 theme.json",
  "type": "object",
  "required": ["name", "version", "apiVersion"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "author": { "type": "string", "maxLength": 60 },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}([-+][0-9A-Za-z.-]+)?$", "maxLength": 32 },
    "apiVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "description": { "type": "string", "maxLength": 500 },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "surface2": { "$ref": "#/$defs/color" },
        "elevated": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "textMuted": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "accentText": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "hover": { "$ref": "#/$defs/color" },
        "danger": { "$ref": "#/$defs/color" },
        "scrollbar": { "$ref": "#/$defs/color" }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": { "$ref": "#/$defs/fontStack" },
        "heading": { "$ref": "#/$defs/fontStack" },
        "mono": { "$ref": "#/$defs/fontStack" },
        "size": { "type": "number", "minimum": 10, "maximum": 24 }
      }
    },
    "fontFaces": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["family", "src"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string", "pattern": "^[A-Za-z0-9 _-]{1,40}$" },
          "src": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]{1,100}\\.(woff2|woff|ttf|otf)$" },
          "weight": { "type": "string", "pattern": "^[0-9]{3}( [0-9]{3})?$" },
          "style": { "type": "string", "enum": ["normal", "italic"] }
        }
      }
    },
    "radius": { "type": "number", "minimum": 0, "maximum": 32 },
    "density": { "type": "string", "enum": ["compact", "comfortable", "spacious"] },
    "nowPlayingBackground": { "type": "string", "enum": ["blur", "gradient", "solid", "none"] },
    "accentFromCover": { "type": "boolean" },
    "sidebarWidth": { "type": "number", "minimum": 64, "maximum": 480 },
    "panelWidth": { "type": "number", "minimum": 200, "maximum": 600 },
    "playerHeight": { "type": "number", "minimum": 48, "maximum": 200 }
  },
  "$defs": {
    "color": { "type": "string", "maxLength": 64, "pattern": "^(#[0-9A-Fa-f]{3,8}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s/-]+\\)|transparent|currentColor|[a-zA-Z]{3,20})$" },
    "fontStack": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9 ,'\"_-]+$" }
  }
}
